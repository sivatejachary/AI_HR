# ============================================================
# RECRUITMENT PRO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

APP_NAME="Recruitment Pro Engine"
APP_ENV=production
DEBUG=false
SECRET_KEY=generate_a_secure_random_key_for_production

# PostgreSQL Database Connection (Single Source of Truth)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/recruitment_pro

# Centralized URL Architecture (Internal vs External URLs)
BACKEND_PUBLIC_URL=https://api.yourcompany.com
BACKEND_INTERNAL_URL=http://backend.internal:8000
FRONTEND_PUBLIC_URL=https://recruitment.yourcompany.com

# CORS Configuration (Comma-separated trusted frontend origins)
CORS_ORIGINS=https://recruitment.yourcompany.com,https://admin.yourcompany.com

# n8n Automation Engine Integration
N8N_PUBLIC_URL=https://shivateja123.app.n8n.cloud
N8N_INTERNAL_URL=http://n8n.internal:5678
N8N_INTEGRATION_API_KEY=your_n8n_integration_bearer_key

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://api.yourcompany.com/api/v1/integrations/google/callback
GOOGLE_PROJECT_ID=your_google_cloud_project_id

# ElevenLabs Conversational Voice AI
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_conversational_agent_id
ELEVENLABS_WEBHOOK_URL=https://api.yourcompany.com/api/v1/calls/elevenlabs-webhook

# Cache & Real-Time Infrastructure (Optional)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
